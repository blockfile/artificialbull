# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# This project READS ONLY. Pons's own per-token fee distributor pays holders;
# nothing here claims, swaps, burns or sends. There is deliberately no wallet
# key, no RPC write path and no database — if you find yourself adding one,
# you are building the distributing fork (ashiba/artidoge), not this one.

# ── Token ────────────────────────────────────────────────────────────────────
# BULL's contract address on Robinhood Chain (launches on the Pons V2
# launchpad). Blank until launch ("CA coming soon") — every stat then answers
# null, which the site renders as "—" rather than a zero, and the rewards feed
# answers an empty page.
TOKEN_ADDRESS=
# Ticker without the "$" — the site shows it as $BULL.
TOKEN_SYMBOL=BULL
TOKEN_NAME=Artificial Bull
# Whole-token total supply and decimals. Used only to keep the pre-graduation
# market cap alive when Blockscout (the normal source) is unreachable. Pons V2
# launches mint 1,000,000,000 at 18 decimals; blank disables the fallback.
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_DECIMALS=18

# ── Upstreams (no API keys needed) ───────────────────────────────────────────
# Blockscout instance for Robinhood Chain — source of the holder count and of
# the rewards feed (token transfers out of the fee distributor).
EXPLORER_API=https://robinhoodchain.blockscout.com
# DexScreener's slug for the chain — source of the market cap.
DEXSCREENER_CHAIN_ID=robinhood

# ── Caching ──────────────────────────────────────────────────────────────────
# How long a fetched value is served before refreshing, in ms. Every visitor's
# browser polls /stats every 60s, so these are what keep the upstreams from
# seeing one request per visitor.
MARKET_TTL_MS=30000
HOLDERS_TTL_MS=120000

# ── Rewards: "Total $<reward> Rewarded" (Pons fee distributor) ──────────────
# BULL's creator tax accrues in the curve's quote asset and is pushed to
# holders by pons's per-token fee distributor. The cumulative "paid to holders"
# total comes from Pons's public API — the same source their token page shows.
PONS_API=https://www.ponsfamily.com
#
# The reward asset: NVDA (tokenized NVIDIA stock, "NVIDIA • Robinhood Token",
# 18 decimals) — the stock the curve is quoted in, so the same asset the creator
# fees arrive in and holders are paid. Verified on chain. There are impostor
# "NVDA" tokens on Robinhood Chain; if this is ever changed, copy the address
# from the token's pons page, never from a ticker search. A wrong address does
# not crash anything — it silently prices the curve off the wrong asset and
# reads an empty payout feed, which looks exactly like "not launched yet".
REWARD_TOKEN_ADDRESS=0xd0601ce157db5bdc3162bbac2a2c8af5320d9eec
REWARD_DECIMALS=18
# Ticker of the reward asset, without the "$". Labels the log lines, `npm run
# check`, and the `<asset>Rewarded` field in /stats (NVDA -> `nvdaRewarded`),
# so the API never names an asset it is not reading.
REWARD_SYMBOL=NVDA
REWARDS_TTL_MS=60000

# ── Rewards feed (GET /rewards) ──────────────────────────────────────────────
# The feed lists reward-asset transfers OUT of the fee distributor (each one is
# a payout to a holder wallet), read from Blockscout. The distributor address is
# resolved from the Pons API automatically; set it here only to pin it (or if
# Pons is down). Leave blank normally.
DISTRIBUTOR_ADDRESS=
# Per-page cache TTL for the feed, in ms.
FEED_TTL_MS=30000

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins that may call the API. Must
# include the scheme. Use "*" to allow any origin (not recommended).
# Non-browser calls (curl, uptime checks) always pass.
CORS_ORIGINS=https://artificialbull.example,https://www.artificialbull.example
